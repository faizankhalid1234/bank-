# Copy to backend/.env (same folder as this file). Never commit .env.

# Root / on Railway: default production → redirect to /admin/ (customer app on Vercel).
# ROOT_ENTRY=spa  → serve React at / on this host too.

# --- Production / Docker (optional locally) ---
# DJANGO_SECRET_KEY=long-random-string
# DEBUG=0
# ALLOWED_HOSTS=yourapp.railway.app,www.example.com
# Optional: full public URL (defaults to https://RAILWAY_PUBLIC_DOMAIN or built-in Railway hostname)
# PUBLIC_APP_URL=https://web-production-77db8.up.railway.app
# DATABASE_URL=postgres://USER:PASS@HOST:5432/DBNAME
# DATABASE_SSL_REQUIRE=1
# Optional extra origins (e.g. local Vite: http://localhost:5173). Default CORS already includes Vercel SPA.
# DEPLOYMENT_CORS_ORIGINS=http://localhost:5173
# DEPLOYMENT_CSRF_TRUSTED_ORIGINS=http://localhost:5173

# BREVO — https://app.brevo.com/settings/keys/smtp
BREVO_SMTP_LOGIN=
BREVO_SMTP_KEY=
# Verified address for From header only — OTP recipient = user’s signup email (To), not this field.
# Required if SMTP login is *@smtp-brevo.com
BREVO_SENDER_EMAIL=
EMAIL_HOST=smtp-relay.brevo.com
EMAIL_PORT=587
EMAIL_USE_TLS=1
# Agar network 587 block kare: EMAIL_PORT=465, EMAIL_USE_TLS=0, EMAIL_USE_SSL=1
# EMAIL_USE_SSL=0
# DEFAULT_FROM_EMAIL=AlyBank <verified@email.com>
BANK_NAME_EMAIL=AlyBank
# Django SMTP open/send timeout (seconds); hung Brevo = faster failure instead of long hang.
# EMAIL_TIMEOUT=25
# Local only: DEBUG + real SMTP send fail par JSON mein email OTP (misconfig debug). Production par mat rakhein.
# EMAIL_OTP_FALLBACK_ON_FAIL=1

# Optional overrides
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
