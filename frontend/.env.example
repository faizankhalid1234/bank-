# Vite loads by mode:
#   .env.development  → npm run dev (committed; Railway URL)
#   .env.production   → npm run build (committed; Railway URL)
#   .env.local        → optional overrides (gitignored) e.g. local Django:
#                       VITE_DJANGO_URL=http://127.0.0.1:8000
#
# Railway API (no trailing slash). Vercel: also set VITE_DJANGO_URL in Project → Environment Variables.
VITE_DJANGO_URL=https://web-production-77db8.up.railway.app
